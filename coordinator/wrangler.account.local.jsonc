{
  "name": "halle-private-account-local",
  "main": "src/account-worker.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "ACCOUNT_DB",
      "database_name": "halle-private-local",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "ACCOUNT_AUDIO", "bucket_name": "halle-private-audio-local" }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
